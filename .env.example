# --- Required ---------------------------------------------------------------
# The single password used to log in.
APP_PASSWORD=change-me
# Long random string used to sign the session cookie (32+ chars).
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Neon Postgres connection string (Vercel's Neon integration sets this for you).
# Leave empty in local dev to use an on-disk PGlite database in ./.pglite
DATABASE_URL=

# --- Screenshot reading (Gemini, free tier) --------------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest.
GEMINI_MODEL=

# --- Screenshot storage (Vercel Blob) --------------------------------------
# Vercel sets this when you connect a Blob store to the project.
# Leave empty in local dev to save screenshots under ./public/uploads
BLOB_READ_WRITE_TOKEN=
# "private" (recommended) or "public" — must match how the Blob store was created.
BLOB_ACCESS=private
